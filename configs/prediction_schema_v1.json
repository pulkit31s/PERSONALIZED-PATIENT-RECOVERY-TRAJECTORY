{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "prediction_schema_v1",
  "title": "ICU Recovery Trajectory Prediction Response",
  "description": "Versioned response schema for the prediction endpoint. All data is synthetic/mock.",
  "type": "object",
  "required": ["schema_version", "request", "predictions", "data_quality", "metadata", "replay"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "prediction_schema_v1"
    },
    "request": {
      "type": "object",
      "required": ["stay_id", "prediction_time"],
      "properties": {
        "stay_id": { "type": "string" },
        "prediction_time": { "type": "string", "format": "date-time" }
      }
    },
    "predictions": {
      "type": "object",
      "required": ["recovery", "icu_stay_time", "organ_support"],
      "properties": {
        "recovery": {
          "type": "object",
          "required": ["delta_24h", "delta_48h", "reconstructed_sofa_24h", "reconstructed_sofa_48h"],
          "properties": {
            "delta_24h": { "type": "number" },
            "delta_48h": { "type": "number" },
            "reconstructed_sofa_24h": { "type": "number" },
            "reconstructed_sofa_48h": { "type": "number" }
          }
        },
        "icu_stay_time": {
          "type": "object",
          "required": ["remaining_hours"],
          "properties": {
            "remaining_hours": { "type": "number" }
          }
        },
        "organ_support": {
          "type": "object",
          "required": ["calibrated_probability"],
          "properties": {
            "calibrated_probability": { "type": "number", "minimum": 0, "maximum": 1 },
            "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "support_class": { "type": "boolean" }
          }
        }
      }
    },
    "explanations": {
      "type": ["object", "null"],
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "method": { "type": "string" },
          "model_hash": { "type": "string" },
          "prediction_cutoff": { "type": "string", "format": "date-time" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "feature_name": { "type": "string" },
                "time_bin": { "type": "string" },
                "timestep": { "type": "integer" },
                "feature_value": { "type": "number" },
                "contribution": { "type": "number" },
                "direction": { "type": "string", "enum": ["positive", "negative"] }
              }
            }
          }
        }
      }
    },
    "data_quality": {
      "type": "object",
      "properties": {
        "observed_bin_counts": { "type": "object" },
        "missingness_summaries": { "type": "object" },
        "padding_indicators": { "type": "object" },
        "available_historical_information": { "type": "object" },
        "feature_masks": { "type": "object" }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["global_pipeline_version", "tasks"],
      "properties": {
        "global_pipeline_version": { "type": "string" },
        "tasks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["model_family", "model_version", "artifact_hash", "feature_version", "label_version", "split_version", "preprocessor_version"],
            "properties": {
              "model_family": { "type": "string" },
              "model_version": { "type": "string" },
              "artifact_hash": { "type": "string" },
              "feature_version": { "type": "string" },
              "label_version": { "type": "string" },
              "split_version": { "type": "string" },
              "preprocessor_version": { "type": "string" },
              "calibrator_version": { "type": "string" },
              "threshold_version": { "type": "string" }
            }
          }
        }
      }
    },
    "replay": {
      "type": "object",
      "required": ["mode", "future_data_used", "history_truncated_at"],
      "properties": {
        "mode": { "type": "string" },
        "future_data_used": { "type": "boolean" },
        "history_truncated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
